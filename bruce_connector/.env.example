# Store this file only on the host; never commit real credentials.
# Must be a separate tunnel from the existing Home Assistant connector.
CONTROL_PLANE_TUNNEL_ID=replace_with_a_new_bruce_tunnel_id
CONTROL_PLANE_API_KEY=replace_with_new_bruce_tunnel_api_key

# MQTT cloud broker reachable from any Wi-Fi by ESP32 and this connector.
BRUCE_DEVICE_ID=t-embed-lab-1
BRUCE_MQTT_HOST=replace-with-broker-hostname.example.net
BRUCE_MQTT_PORT=8883
BRUCE_MQTT_USER=bruce_connector
BRUCE_MQTT_PASSWORD=replace_with_unique_gateway_broker_password
# BRUCE_MQTT_CA_PEM=/run/secrets/broker-ca.pem  # Only for private CA; system CAs work by default
